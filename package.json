{
  "name": "todos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "todos": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "dev": "tsx src/cli.tsx",
    "web": "vite --config web/vite.config.ts",
    "test:browser": "vite build --config web/vite.config.ts && playwright test"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@block65/webcrypto-web-push": "^2.0.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "ink": "^8.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.61.0",
    "marked": "^15.0.12",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ink-testing-library": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.0"
  }
}
